# Copy this file to .env.local and fill in the values.

# Supabase (used later for auth, database, and image storage).
# Get these from your Supabase project settings once you create it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No key is needed for the Met, Art Institute, or Cleveland APIs.

# Key-based museums. Each appears in the dropdown only when its key is set.
# Harvard Art Museums — request at https://harvardartmuseums.org/collections/api
HARVARD_API_KEY=
# Smithsonian Open Access — request an api.data.gov key at https://api.data.gov/signup/
SMITHSONIAN_API_KEY=

# Public site origin (no trailing slash), e.g. https://mooseium.app — powers
# canonical URLs, Open Graph/preview image URLs, sitemap, and robots. MUST be set
# in production or these all point at localhost.
NEXT_PUBLIC_SITE_URL=

# Distributed rate limiting (optional but recommended for production). Create a
# free Upstash Redis database (https://console.upstash.com) and paste its REST
# URL + token. When absent, the app falls back to a per-instance in-memory limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
